diff --git a/include/rex/chrono/chrono.h b/include/rex/chrono/chrono.h
index d876846..5b9dfcf 100644
--- a/include/rex/chrono/chrono.h
+++ b/include/rex/chrono/chrono.h
@@ -116,8 +116,9 @@ using XSystemClock = detail::NtSystemClock<detail::Domain::Guest>;
 
 namespace std::chrono {
 
-#ifdef __APPLE__
-// Apple libc++ does not expose clock_time_conversion or clock_cast.
+#if defined(__APPLE__) || defined(__PROSPERO__)
+// Apple libc++ does not expose clock_time_conversion or clock_cast, nor does
+// the PS5 payload SDK's libc++ 18.
 template <class, class>
 struct clock_time_conversion {};
 
diff --git a/include/rex/platform/dynlib.h b/include/rex/platform/dynlib.h
index e3fc40d..a6a6d68 100644
--- a/include/rex/platform/dynlib.h
+++ b/include/rex/platform/dynlib.h
@@ -71,6 +71,14 @@ inline constexpr const char* kVulkanLoader = "libvulkan.1.dylib";
 inline constexpr const char* kRenderDoc = "librenderdoc.dylib";
 inline constexpr const char* kSpirvToolsSdkPath = "lib/libSPIRV-Tools-shared.dylib";
 
+#elif REX_PLATFORM_PS5
+
+// The console loads no libraries at run time: a title links everything it uses,
+// RADV included. Lookups of these names fail, and callers fall back.
+inline constexpr const char* kVulkanLoader = "";
+inline constexpr const char* kRenderDoc = "";
+inline constexpr const char* kSpirvToolsSdkPath = "";
+
 #else
 #error No library names provided for the target platform.
 #endif
